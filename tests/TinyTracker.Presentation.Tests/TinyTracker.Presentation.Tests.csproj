<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TinyTracker.Presentation\TinyTracker.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <!-- Test folders and the leftover check, shared with the Core tests. -->
  <ItemGroup>
    <Compile Include="..\Shared\LeftoverCheck.cs" Link="LeftoverCheck.cs" />
    <Using Include="TinyTracker.Tests" />
  </ItemGroup>
  <!-- The demo builds only in Debug, and so do its tests. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Demo\**" />
  </ItemGroup>
</Project>
