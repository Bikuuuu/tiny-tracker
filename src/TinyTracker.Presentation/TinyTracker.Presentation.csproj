<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyTracker.Core\TinyTracker.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <!-- The demo builds only in Debug, where it can run. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Demo\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The build generates a public Strings class, so XAML can bind to it. -->
    <EmbeddedResource Update="Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>TinyTracker.Presentation</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
</Project>
