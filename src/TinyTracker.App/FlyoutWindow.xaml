<Window
    x:Class="TinyTracker.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Opacity="0" KeyboardAcceleratorPlacementMode="Hidden" Background="{ThemeResource FlyoutBackground}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Frame x:Name="Pages" />
    </Grid>
</Window>
