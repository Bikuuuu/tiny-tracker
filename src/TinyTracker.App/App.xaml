<Application
    x:Class="TinyTracker.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The Security pill: blue, and in high contrast the theme's highlight colors. The Auto pill: the accent, and in
                 high contrast the theme's button colors with a border, so the two stay distinct. The flyout: the theme's window
                 color in high contrast, over the acrylic. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SecurityPillBackground" Color="#005FB8" />
                    <StaticResource x:Key="SecurityPillForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                    <StaticResource x:Key="AutoPillBackground" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="AutoPillForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                    <SolidColorBrush x:Key="AutoPillBorder" Color="Transparent" />
                    <Thickness x:Key="AutoPillBorderThickness">0</Thickness>
                    <SolidColorBrush x:Key="FlyoutBackground" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SecurityPillBackground" Color="#299FFF" />
                    <StaticResource x:Key="SecurityPillForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                    <StaticResource x:Key="AutoPillBackground" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="AutoPillForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                    <SolidColorBrush x:Key="AutoPillBorder" Color="Transparent" />
                    <Thickness x:Key="AutoPillBorderThickness">0</Thickness>
                    <SolidColorBrush x:Key="FlyoutBackground" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SecurityPillBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SecurityPillForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AutoPillBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="AutoPillForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AutoPillBorder" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <Thickness x:Key="AutoPillBorderThickness">1</Thickness>
                    <SolidColorBrush x:Key="FlyoutBackground" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Icons keep their size at large text sizes, as Windows' own do. -->
            <Style TargetType="FontIcon">
                <Setter Property="IsTextScaleFactorEnabled" Value="False" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="Footer" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="Critical" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,10,0,2" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>
            <!-- A switch on a card: no On/Off words and no 154 px minimum, so it lines up at the card's edge. -->
            <Style x:Key="CardToggle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Margin" Value="0,0,-12,0" />
            </Style>
            <!-- A button that looks like a link and can open a flyout. -->
            <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <!-- A security fix's pill after an update's versions. -->
            <Style x:Key="SecurityPill" TargetType="Border">
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Padding" Value="6,0,6,1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource SecurityPillBackground}" />
            </Style>
            <!-- An Auto app's pill after its name. -->
            <Style x:Key="AutoPill" TargetType="Border">
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Padding" Value="6,0,6,1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="{ThemeResource AutoPillBorderThickness}" />
                <Setter Property="Background" Value="{ThemeResource AutoPillBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AutoPillBorder}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
