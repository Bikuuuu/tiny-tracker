<pages:FlyoutPage
    x:Class="TinyTracker.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:TinyTracker.App"
    xmlns:controls="using:TinyTracker.App.Controls"
    xmlns:history="using:TinyTracker.Presentation.History"
    xmlns:pages="using:TinyTracker.App.Pages"
    xmlns:p="using:TinyTracker.Presentation"
    NavigationCacheMode="Required">
    <pages:FlyoutPage.Resources>
        <DataTemplate x:Key="NoticeBar" x:DataType="p:Notice">
            <controls:NoticeBar Closed="OnNoticeClosed" />
        </DataTemplate>

        <!-- One entry: result icon, app icon, name, what happened, and the time or Retry. Focusable, so arrow keys reach it. -->
        <DataTemplate x:Key="EntryRow" x:DataType="history:HistoryRow">
            <ContentControl IsTabStop="True" UseSystemFocusVisuals="True" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                            KeyDown="OnRowKeyDown">
                <Grid Padding="10,6" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind IsUpdated}" />
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsWarning}" />
                        <FontIcon Glyph="&#xEA39;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind IsFailed}" />
                        <FontIcon Glyph="&#xE893;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsSkipped}" />
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsCancelled}" />
                    </Grid>
                    <controls:AppIcon Grid.Column="1" Width="32" Height="32" LocalId="{x:Bind LocalId, Mode=OneWay}" AppName="{x:Bind Name}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" controls:RowStatus.View="{x:Bind StatusLine}" Visibility="{x:Bind app:Ui.Collapsed(IsFailed)}" />
                        <TextBlock Style="{StaticResource Critical}" TextWrapping="Wrap" controls:RowStatus.View="{x:Bind StatusLine}" Visibility="{x:Bind IsFailed}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{x:Bind Time, Mode=OneWay}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Visibility="{x:Bind ShowsTime, Mode=OneWay}" />
                    <Button Grid.Column="3" VerticalAlignment="Center" Content="{x:Bind p:Strings.Retry}" Command="{x:Bind RetryCommand}"
                            Visibility="{x:Bind CanRetry, Mode=OneWay}" AutomationProperties.Name="{x:Bind RetryName}" />
                </Grid>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="DayGroup" x:DataType="history:HistoryGroup">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource EntryRow}" XYFocusKeyboardNavigation="Enabled" IsTabStop="False">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>
    </pages:FlyoutPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Top" Padding="16,12,16,8" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="OnBack" ToolTipService.ToolTip="{x:Bind p:Strings.Back}" ToolTipService.Placement="Bottom" AutomationProperties.Name="{x:Bind p:Strings.Back}">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Text="{x:Bind p:Strings.History}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{x:Bind History.Notices}" ItemTemplate="{StaticResource NoticeBar}" IsTabStop="False" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1">
            <StackPanel x:Name="Body" Padding="16,0,16,12" Spacing="4">
                <StackPanel Visibility="{x:Bind History.IsEmpty, Mode=OneWay}" Spacing="4" Padding="0,24" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind p:Strings.HistoryEmpty}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind p:Strings.HistoryEmptyHelp}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind History.Groups}" ItemTemplate="{StaticResource DayGroup}" XYFocusKeyboardNavigation="Enabled" IsTabStop="False" />
                <Button HorizontalAlignment="Center" Margin="0,8,0,0" Content="{x:Bind p:Strings.ShowOlder}" Command="{x:Bind History.ShowOlderCommand}"
                        Visibility="{x:Bind History.CanShowOlder, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="Bottom" Grid.Row="2" Style="{StaticResource Footer}" Visibility="{x:Bind app:Ui.Collapsed(History.IsEmpty), Mode=OneWay}">
            <controls:FitOrStack FirstShare="0.4">
                <TextBlock Text="{x:Bind p:Strings.Last90Days}" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" FontSize="12" Content="{x:Bind p:Strings.ClearHistory}" IsEnabled="{x:Bind History.CanClear, Mode=OneWay}">
                    <Button.Flyout>
                        <Flyout x:Name="ConfirmClear">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind p:Strings.ClearHistoryConfirm}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind p:Strings.Clear}" Click="OnClear" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </controls:FitOrStack>
        </Grid>
    </Grid>
</pages:FlyoutPage>
